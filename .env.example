# Copy to .env.local and fill in. Names only — never commit real values.
#
# Which file is read when (Vite's rules: .env, .env.local, .env.<mode>,
# .env.<mode>.local, later files winning):
#   npm run dev, npm run ios:local   mode "development"  .env.local, .env.development.local
#   npm run build                    mode "production"   .env.local, .env.production.local
#   npm run ios:staging              mode "staging"      .env.local, .env.staging.local
#   npm run ios:prod                 mode "prod"         .env.local, .env.prod.local
# The ops scripts (scripts/*.mjs) and `npm run bench:strategies` read
# .env.development.local only, falling back to the shell environment; the
# other benchmarks only read the shell environment
# (e.g. `node --env-file=.env.local --import tsx benchmarks/voice/emotion.ts`).
# vite.config.ts loads every variable (not just VITE_*) into process.env so
# the api/ functions work under `npm run dev`. On Vercel, set them per
# environment in the project settings instead.

# --- Server only (api/ functions; never prefix these with VITE_) ---

# Claude API key: script parsing, voice casting, line direction.
ANTHROPIC_API_KEY=
# ElevenLabs API key: speech synthesis, speech-to-speech, Scribe tokens, voice catalog.
ELEVENLABS_API_KEY=
# Supabase service-role key: bypasses row-level security. Server and ops scripts only.
SUPABASE_SERVICE_ROLE_KEY=
# Stripe secret key (sk_test_… locally, sk_live_… in production).
STRIPE_SECRET_KEY=
# Signing secret of the Stripe webhook endpoint that points at /api/stripe-webhook.
STRIPE_WEBHOOK_SECRET=
# Stripe price of the subscription (create it with scripts/stripe-setup.mjs).
STRIPE_PRICE_ID=
# Signs the short-lived rehearsal grants the TTS/STS endpoints verify. openssl rand -base64 32
REHEARSAL_GRANT_SECRET=

# --- Public (compiled into the client bundle; assume anyone can read them) ---

# Supabase project URL. Also read by the api/ functions and ops scripts.
VITE_SUPABASE_URL=
# Supabase anon (publishable) key.
VITE_SUPABASE_ANON_KEY=
# Stripe publishable key (pk_test_… / pk_live_…).
VITE_STRIPE_PUBLISHABLE_KEY=
# "false" turns the paywall on; anything else (or unset) keeps beta mode: free, NDA at signup.
# Must be set to the same value for the build and for the deployed functions.
VITE_BETA_TESTING=
# iOS builds only: the deployed site the app calls for /api and auth links, e.g. https://example.com
VITE_WEB_ORIGIN=
# Optional, server only: the web origin Stripe returns to after checkout. Defaults to the production site.
APP_WEB_ORIGIN=
# iOS staging/local builds only: Vercel protection-bypass secret for the SSO-protected
# staging deployment. NEVER set for production — it ships in the bundle.
# tools/check-prod-env.mjs fails the production builds if it is.
VITE_VERCEL_BYPASS_SECRET=

# --- Benchmarks only (optional) ---

# Gemini key for the AI listening rater (npm run bench:emotion -- --ai-rate).
GEMINI_API_KEY=
