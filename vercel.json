{
  "functions": {
    "api/parse-script.ts": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|@|src/|node_modules/|.*\\.\\w+$).*)",
      "destination": "/index.html"
    }
  ]
}
